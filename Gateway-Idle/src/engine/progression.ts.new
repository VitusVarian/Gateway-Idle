import BigNumber from 'bignumber.js'

export const MONSTER_BASE_HIT_POINTS = 100
export const MONSTER_COEFFICIENT = 12
export const MONSTER_GROWTH_RATE = 1.08
export const BOSS_LEVELS = [10, 100, 1000]

export interface TrainingUpgradeDefinition {
  key: 'strengthGrowth' | 'experienceModifier' | 'monsterSoulModifier'
  label: string
  baseCost: number
  costGrowth: number
}

export const TRAINING_UPGRADE_DEFINITIONS: TrainingUpgradeDefinition[] = [
  { key: 'strengthGrowth', label: 'Strength Growth', baseCost: 10, costGrowth: 1.35 },
  { key: 'experienceModifier', label: 'Experience Modifier', baseCost: 12, costGrowth: 1.3 },
  { key: 'monsterSoulModifier', label: 'Monster Soul Modifier', baseCost: 14, costGrowth: 1.25 },
]

export function isBossStage(stage: number): boolean {
  return BOSS_LEVELS.includes(stage)
}

export function calculateMonsterHitPoints(level: number): number {
  const rawHp = MONSTER_BASE_HIT_POINTS * (level * MONSTER_COEFFICIENT + Math.pow(MONSTER_GROWTH_RATE, level))
  const tierMultiplier = Math.pow(2, BOSS_LEVELS.filter((bossLevel) => bossLevel <= level).length)
  return Math.floor(rawHp * tierMultiplier)
}

export function calculateTrainingMilestoneReward(level: number): BigNumber {
  const milestoneLevels = [10, 25, 50, 100, 250, 500, 1000]
  let reward = new BigNumber(0)

  milestoneLevels.forEach((milestoneLevel, index) => {
    if (level >= milestoneLevel) {
      reward = reward.plus(1 + Math.floor(Math.sqrt(index + 1)))
    }
  })

  return reward.isZero() ? new BigNumber(1) : reward
}
